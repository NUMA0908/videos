{
  "name": "contragolpe",
  "private": true,
  "version": "0.1.0",
  "description": "Juego de peleas 2D 1 contra 1 en el navegador (TypeScript + Vite + Canvas 2D)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "framedata": "tsx scripts/framedata.ts",
    "sim": "tsx scripts/balance.ts",
    "electron:compile": "node scripts/electron-compile.mjs",
    "app:dev": "node scripts/electron-dev.mjs"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "electron": "44.5.1",
    "electron-builder": "26.17.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  },
  "main": "dist-electron/main.js"
}
